### Nginx Configuration
NGINX_PORT=9000

### Application
PROJECT_NAME=tstation-ai
ENV=dev ## ['local', 'dev', 'staging', 'prod']
LOG_LEVEL=INFO ## ['DEBUG', 'INFO', 'WARNING', 'ERROR']
APP_PORT=8000
ROOT_PATH=/api
APP_STATIC_DIR=static
APP_PUBLIC_DIR=static/public
API_SECRET_KEY=ADD_KEY
TZ_OFFSET=7 # Timezone of app (UTC)
# AI Model
UPSTAGE_API_KEY=ADD_KEY
AWS_BEARER_TOKEN_BEDROCK=ADD_KEY

### AI Internal Gateway
AI_DEFAULT_PROVIDER=openai
AI_GATEWAY_BASE_URL=http://ai-gateway:8000/v1
AI_GATEWAY_API_KEY=ADD_KEY


### Queue System
# Redis
REDIS_PASSWORD=ADD_KEY
REDIS_URL=redis://:REDIS_PASSWORD@redis:6379/0
# RabbitMQ
RABBITMQ_NODENAME=rabbit@rabbitmq
RABBITMQ_USERNAME=ADD_KEY
RABBITMQ_PASSWORD=ADD_KEY
RABBITMQ_TM_PORT=15672
RABBITMQ_URL=amqp://RABBITMQ_USERNAME:RABBITMQ_PASSWORD@rabbitmq:5672//
RABBITMQ_URL_MANAGEMENT=http://RABBITMQ_USERNAME:RABBITMQ_PASSWORD@rabbitmq:15672/
# Celery Worker
NUM_WORKER=3
# List Queue Available


### AWS
# Credential
AWS_ACCESS_KEY_ID=ADD_KEY
AWS_SECRET_ACCESS_KEY=ADD_KEY
AWS_DEFAULT_REGION=ap-northeast-2
# S3 Bucket
S3_BUCKET_NAME=ADD_KEY


### Monitoring & Tracing
# Grafana UI
GF_SECURITY_ADMIN_USER=ADD_KEY
GF_SECURITY_ADMIN_PASSWORD=ADD_KEY
# Loki log
LOKI_URL=ADD_KEY
# Prometheus Metrics
PROMETHEUS_URL=ADD_KEY
# Langfuse tracing
LANGFUSE_HOST=ADD_KEY
LANGFUSE_PROJECT_NAME=tstation-ai
LANGFUSE_SECRET_KEY=ADD_KEY
LANGFUSE_PUBLIC_KEY=ADD_KEY