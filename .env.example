# Copy this file to .env and provide every blank value for the target environment.
# Never commit real credentials or customer-specific private endpoints.

### Nginx Configuration
NGINX_PORT=80
HTTPS_PORT=443

### Application
PROJECT_NAME=tstation-ai
ENV=dev ## ['local', 'dev', 'staging', 'prod']
PROJECT_PREFIX=tstation-agent
LOG_LEVEL=INFO ## ['DEBUG', 'INFO', 'WARNING', 'ERROR']
APP_PORT=8000
ROOT_PATH=/api
APP_STATIC_DIR=static
APP_PUBLIC_DIR=static/public
API_SECRET_KEY=
TZ_OFFSET=7 # Timezone of app (UTC)
# AI Model
UPSTAGE_API_KEY=
AWS_BEARER_TOKEN_BEDROCK=

### AI Internal Gateway
AI_DEFAULT_PROVIDER=openai
AI_GATEWAY_BASE_URL=http://ai-gateway:8000/v1
AI_GATEWAY_API_KEY=
# PostgreSQL for LiteLLM spend tracking & per-user token budgets
# Format: postgresql://user:password@host:5432/dbname
LITELLM_DB_URL=
LANGFUSE_DB_URL=
LITELLM_USER_MAX_BUDGET=20.0
LITELLM_USER_BUDGET_DURATION=1mo
MONTHLY_TOKEN_LIMIT=2000000
# Model tiers (reference values — declare what's available)
AI_MODEL=gpt-5.5
AI_MODEL_REASONING=gpt-5.5-reasoning-low
AI_MODEL_MINI=gpt-4o-mini
# Chat V3: fast normal path, stronger contract/QC fallback
AI_MODEL_TOOL_SELECTOR=gpt-5.6-luna
AI_MODEL_COMPOSER=gpt-5.6-luna
AI_MODEL_FALLBACK=gpt-5.6-terra-low
# Per-agent model overrides
AI_MODEL_LEADING_AGENT=gpt-4o-mini
AI_MODEL_QC_AGENT=gpt-4o-mini
AI_MODEL_TRANSACTION_AGENT=gpt-5.5-reasoning-low
# Redis Conversation Management (DB 0: conversation history)
REDIS_CONVERSATION_MANAGEMENT_PASSWORD=
REDIS_CONVERSATION_MANAGEMENT_URL=redis://:${REDIS_CONVERSATION_MANAGEMENT_PASSWORD}@redis-conversation-management:6379/0
# Redis Queue (DB 1: task queue tracking + Celery backend)
REDIS_QUEUE_URL=redis://:${REDIS_CONVERSATION_MANAGEMENT_PASSWORD}@redis-conversation-management:6379/1


### Queue System
# Redis
REDIS_PASSWORD=
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
# RabbitMQ
RABBITMQ_NODENAME=rabbit@rabbitmq
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=
RABBITMQ_TM_PORT=15672
RABBITMQ_URL=amqp://${RABBITMQ_USERNAME}:${RABBITMQ_PASSWORD}@rabbitmq:5672//
RABBITMQ_URL_MANAGEMENT=http://${RABBITMQ_USERNAME}:${RABBITMQ_PASSWORD}@rabbitmq:15672/
# Celery Worker
NUM_WORKER=3
# List Queue Available


### AWS
# Credential
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-northeast-2
# S3 Bucket
S3_BUCKET_NAME=


### Monitoring & Tracing
# Grafana UI
GF_SECURITY_ADMIN_USER=
GF_SECURITY_ADMIN_PASSWORD=
# Loki log
LOKI_URL=
# Prometheus Metrics
PROMETHEUS_URL=
# Langfuse tracing (self-hosted via docker-compose)
LANGFUSE_HOST=http://langfuse-server:3000
LANGFUSE_PROJECT_NAME=tstation-ai
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=

# Langfuse self-hosted stack (only used by docker-compose)
LANGFUSE_PORT=3002
LANGFUSE_NEXTAUTH_URL=http://localhost:3002
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_POSTGRES_PASSWORD=
LANGFUSE_CLICKHOUSE_PASSWORD=
LANGFUSE_REDIS_PASSWORD=
LANGFUSE_REDIS_URL=redis://:${LANGFUSE_REDIS_PASSWORD}@langfuse-redis:6379/0
LANGFUSE_MINIO_USER=
LANGFUSE_MINIO_PASSWORD=
LANGFUSE_INIT_ORG_ID=tstation-org
LANGFUSE_INIT_ORG_NAME=T-Station
LANGFUSE_INIT_PROJECT_ID=tstation-ai
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_NAME=
LANGFUSE_INIT_USER_PASSWORD=

### AI Runtime Flags
OPENAI_API_KEY=
AI_GATEWAY_PORT=8000
AI_QC_ENABLED=true
AI_QC_PARALLEL=false
AI_SPECULATIVE_CLASSIFY_ENABLED=false
UVICORN_WORKERS=1

### Vector Database & Embeddings
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION_FAQ=faq_documents
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
FAQ_SEARCH_MODE=hybrid

### T-Station Backend
TSTATION_BE_API=
TSTATION_BE_SPEC_URL=
TSTATION_BE_MCP=
# FAQ Periodic Sync (tstation-ingestion → Qdrant)
FAQ_SYNC_INTERVAL_SECONDS=25200

### T-Station Web (Chatbot CTA URLs)
# Override per environment to flip QA → prod with a single env change.
# Used by services/tstation/common/cta_urls.py (chip url, qnaComplete redirect).
TSTATION_WEB_PC_BASE=https://www.tstation.com
TSTATION_WEB_MOBILE_BASE=https://m.tstation.com

### Chat Encryption
CHAT_ENCRYPTION_ENABLED=false
CHAT_ENCRYPTION_MODE=local
CHAT_ENCRYPTION_LOCAL_KEY=
CHAT_ENCRYPTION_KMS_KEY_ID=

### Evaluation
JWT_TOKEN=
JUDGE_MODEL=gpt-4o-mini
